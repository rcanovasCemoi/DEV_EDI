[general]
scan_interval_sec = 5
stability_scans = 2
max_retries = 5
archive_retention_days = 7
state_dir = /var/lib/edi-sync
# log_file = /var/log/edi-sync/daemon.log   # optionnel : copie des logs JSON dans un fichier (utile sans acces au journal)
# local_archive_dir = /opt/EDI/ARCHIVE       # archive locale des fichiers transferes, dans <local_archive_dir>/<flow>/ ; vide = pas d'archive

[sftp_babelway]
host = sftp-babelway.exemple.com
port = 22
user = edi
key_file = /etc/edi-sync/keys/id_rsa_babelway
# une ou plusieurs empreintes sha256 du serveur, separees par des virgules
# (recuperees via: ssh-keyscan -t rsa,ecdsa,ed25519 <host> | ssh-keygen -lf -)
host_fingerprint = sha256:REMPLACER_PAR_L_EMPREINTE_DU_SERVEUR

[sftp_keane]
host = sftp-keane.exemple.com
port = 22
user = edi
key_file = /etc/edi-sync/keys/id_rsa_keane
host_fingerprint = sha256:REMPLACER_PAR_L_EMPREINTE_DU_SERVEUR

[flow_babelway_to_keane]
source = sftp_babelway
source_dir = /out
dest = sftp_keane
dest_dir = /in
# dest_tmp_suffix = .tmp   # upload en .<nom>.tmp puis rename (defaut) ; laisser VIDE pour uploader directement au nom final
                          # (obligatoire si la plateforme destination deplace les fichiers instantanement, ex. babelway IN)

[flow_keane_to_babelway]
source = sftp_keane
source_dir = /out
dest = sftp_babelway
dest_dir = /in
dest_tmp_suffix =         # upload direct au nom final (pas de .tmp) car babelway prend les fichiers dans IN instantanement

[monitoring]
enabled = true
bind = 127.0.0.1
port = 8443
# tls_cert / tls_key : laisser vide pour un certificat auto-signe genere dans state_dir/certs/
# auth_user / auth_password_sha256 : laisser vide pour desactiver l'authentification Basic
# auth_password_sha256 = sha256 du mot de passe (ex: echo -n 'motdepasse' | sha256sum)
