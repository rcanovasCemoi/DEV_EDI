[Unit]
Description=EDI sync daemon (mode utilisateur, sans root)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__APP_DIR__/venv/bin/python __APP_DIR__/edi_sync.py --config __APP_DIR__/config.ini
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true

[Install]
WantedBy=default.target
