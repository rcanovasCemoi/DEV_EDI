[Unit]
Description=EDI SFTP realtime sync (bidirectionnel babelway <-> keane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edisync
Group=edisync
ExecStart=__APP_DIR__/venv/bin/python __APP_DIR__/edi_sync.py --config /etc/edi-sync/config.ini
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/edi-sync /var/log/edi-sync

[Install]
WantedBy=multi-user.target
